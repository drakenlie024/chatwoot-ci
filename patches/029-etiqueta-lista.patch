+// Fundo da pilula: a cor da etiqueta clareada ate virar um pastel, igual ao
+// .tag do guia de identidade (fundo suave + texto colorido + ponto).
+const fpSoft = hex => {
+  const m = /^#?([0-9a-f]{6})$/i.exec(String(hex || ''));
+  if (!m) return 'rgba(107, 122, 144, 0.14)';
+  const n = parseInt(m[1], 16);
+  const mix = c => Math.round(c + (255 - c) * 0.86);
+  return `rgb(${mix((n >> 16) & 255)},${mix((n >> 8) & 255)},${mix(n & 255)})`;
+};
