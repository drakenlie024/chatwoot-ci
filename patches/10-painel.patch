@@ -0,0 +1,42 @@
+<script>
+// Pagina que exibe o painel de clientes da FP Consignado dentro do Chatwoot.
+// O painel e uma aplicacao separada, no mesmo dominio, em /clientes.
+//
+// Com rotas de verdade (/clientes/:aba) o Vue reaproveita ESTE componente e so
+// o `watch` troca a URL do iframe. O painel le a aba em `?aba=` na propria URL.
+const ABA_POR_ROTA = {
+  clientes_busca: 'busca',
+  clientes_fila: 'fila',
+  clientes_negociacao: 'negociacao',
+  clientes_relatorios: 'relatorios',
+  clientes_campanhas: 'campanhas',
+  clientes_disparo: 'disparo',
+};
+
+function urlDaAba(nomeRota) {
+  const aba = ABA_POR_ROTA[nomeRota];
+  return '/clientes' + (aba ? '?aba=' + encodeURIComponent(aba) : '');
+}
+
+export default {
+  name: 'ClientesPage',
+  data() {
+    return { src: urlDaAba(this.$route?.name) };
+  },
+  watch: {
+    // A sidebar muda de rota; sem este watch o Vue reaproveita a pagina, o
+    // iframe nao recarrega e os itens do menu nao fazem nada.
+    '$route.name'(nomeRota) {
+      this.src = urlDaAba(nomeRota);
+    },
+  },
+};
+</script>
+
+<template>
+  <iframe
+    :src="src"
+    title="Clientes"
+    class="w-full h-full border-0 flex-1 bg-n-surface-1"
+  />
+</template>
diff --git a/app/javascript/dashboard/routes/dashboard/clientes/clientes.routes.js b/app/javascript/dashboard/routes/dashboard/clientes/clientes.routes.js
new file mode 100644
index 0000000..5b7aceb
--- /dev/null
+++ b/app/javascript/dashboard/routes/dashboard/clientes/clientes.routes.js
@@ -0,0 +1,57 @@
+import { frontendURL } from '../../../helper/URLHelper';
+import Clientes from './Clientes.vue';
+
+// Cada aba do painel e uma rota de verdade (nao mais ?aba=...). Isso faz o item
+// da sidebar ficar ACESO no menu e o Vue reaproveitar a pagina trocando so o
+// iframe. As permissoes de cada rota sao o que esconde os itens de administrador
+// do agente (a sidebar filtra os filhos por `meta.permissions`).
+const TODOS = { permissions: ['administrator', 'agent', 'custom_role'] };
+const ADMIN = { permissions: ['administrator'] };
+
+export const routes = [
+  {
+    path: frontendURL('accounts/:accountId/clientes'),
+    name: 'clientes_index',
+    component: Clientes,
+    meta: ADMIN,
+  },
+  {
+    // a busca do agente/operador (a NOSSA busca - CPF, beneficio, telefone)
+    path: frontendURL('accounts/:accountId/clientes/busca'),
+    name: 'clientes_busca',
+    component: Clientes,
+    meta: TODOS,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/fila'),
+    name: 'clientes_fila',
+    component: Clientes,
+    meta: TODOS,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/negociacao'),
+    name: 'clientes_negociacao',
+    component: Clientes,
+    meta: TODOS,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/relatorios'),
+    name: 'clientes_relatorios',
+    component: Clientes,
+    meta: ADMIN,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/campanhas'),
+    name: 'clientes_campanhas',
+    component: Clientes,
+    // Operador tambem pode pedir disparo pelo menu.
+    meta: TODOS,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/disparo'),
+    name: 'clientes_disparo',
+    component: Clientes,
+    // Operador tambem pode pedir disparo pelo menu.
+    meta: TODOS,
+  },
+];
