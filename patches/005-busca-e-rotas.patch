@@ -1,13 +1,55 @@
 import { frontendURL } from '../../../helper/URLHelper';
 import Clientes from './Clientes.vue';
 
+// Cada aba do painel e uma rota de verdade (nao mais ?aba=...). Isso faz o item
+// da sidebar ficar ACESO no menu e o Vue reaproveitar a pagina trocando so o
+// iframe. As permissoes de cada rota sao o que esconde os itens de administrador
+// do agente (a sidebar filtra os filhos por `meta.permissions`).
+const TODOS = { permissions: ['administrator', 'agent', 'custom_role'] };
+const ADMIN = { permissions: ['administrator'] };
+
 export const routes = [
   {
     path: frontendURL('accounts/:accountId/clientes'),
     name: 'clientes_index',
     component: Clientes,
-    meta: {
-      permissions: ['administrator', 'agent', 'custom_role'],
-    },
+    meta: ADMIN,
+  },
+  {
+    // a busca do agente/operador (a NOSSA busca - CPF, beneficio, telefone)
+    path: frontendURL('accounts/:accountId/clientes/busca'),
+    name: 'clientes_busca',
+    component: Clientes,
+    meta: TODOS,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/fila'),
+    name: 'clientes_fila',
+    component: Clientes,
+    meta: TODOS,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/negociacao'),
+    name: 'clientes_negociacao',
+    component: Clientes,
+    meta: TODOS,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/relatorios'),
+    name: 'clientes_relatorios',
+    component: Clientes,
+    meta: ADMIN,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/campanhas'),
+    name: 'clientes_campanhas',
+    component: Clientes,
+    meta: ADMIN,
+  },
+  {
+    path: frontendURL('accounts/:accountId/clientes/disparo'),
+    name: 'clientes_disparo',
+    component: Clientes,
+    meta: ADMIN,
   },
 ];
