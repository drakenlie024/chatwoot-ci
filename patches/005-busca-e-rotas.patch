diff --git a/app/javascript/dashboard/routes/dashboard/clientes/Clientes.vue b/app/javascript/dashboard/routes/dashboard/clientes/Clientes.vue
index 05c76d5..ee2b111 100644
--- a/app/javascript/dashboard/routes/dashboard/clientes/Clientes.vue
+++ b/app/javascript/dashboard/routes/dashboard/clientes/Clientes.vue
@@ -1,17 +1,33 @@
 <script>
 // Pagina que exibe o painel de clientes da FP Consignado dentro do Chatwoot.
 // O painel e uma aplicacao separada, no mesmo dominio, em /clientes.
+//
+// Com rotas de verdade (/clientes/:aba) o Vue reaproveita ESTE componente e so
+// o `watch` troca a URL do iframe. O painel le a aba em `?aba=` na propria URL.
+const ABA_POR_ROTA = {
+  clientes_busca: 'busca',
+  clientes_fila: 'fila',
+  clientes_negociacao: 'negociacao',
+  clientes_relatorios: 'relatorios',
+  clientes_campanhas: 'campanhas',
+  clientes_disparo: 'disparo',
+};
+
+function urlDaAba(nomeRota) {
+  const aba = ABA_POR_ROTA[nomeRota];
+  return '/clientes' + (aba ? '?aba=' + encodeURIComponent(aba) : '');
+}
+
 export default {
   name: 'ClientesPage',
   data() {
-    const aba = new URLSearchParams(window.location.search).get('aba');
-    return { src: '/clientes' + (aba ? '?aba=' + encodeURIComponent(aba) : '') };
+    return { src: urlDaAba(this.$route?.name) };
   },
   watch: {
-    // A sidebar muda SO a query (?aba=fila). Sem este watch o Vue reaproveita
-    // a pagina, o iframe nao recarrega e os itens do menu nao fazem nada.
-    '$route.query.aba'(nova) {
-      this.src = '/clientes' + (nova ? '?aba=' + encodeURIComponent(nova) : '');
+    // A sidebar muda de rota; sem este watch o Vue reaproveita a pagina, o
+    // iframe nao recarrega e os itens do menu nao fazem nada.
+    '$route.name'(nomeRota) {
+      this.src = urlDaAba(nomeRota);
     },
   },
 };
diff --git a/app/javascript/dashboard/routes/dashboard/clientes/clientes.routes.js b/app/javascript/dashboard/routes/dashboard/clientes/clientes.routes.js
