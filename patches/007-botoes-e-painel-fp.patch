diff --git a/app/javascript/dashboard/components/widgets/conversation/FpActions.vue b/app/javascript/dashboard/components/widgets/conversation/FpActions.vue
new file mode 100644
index 0000000..10303a6
--- /dev/null
+++ b/app/javascript/dashboard/components/widgets/conversation/FpActions.vue
@@ -0,0 +1,177 @@
+<script setup>
+import { computed, ref } from 'vue';
+import { useStore } from 'vuex';
+import { useUISettings } from 'dashboard/composables/useUISettings';
+import { vOnClickOutside } from '@vueuse/components';
+
+const props = defineProps({
+  chat: {
+    type: Object,
+    default: () => ({}),
+  },
+});
+
+const store = useStore();
+const { updateUISettings } = useUISettings();
+const isOpen = ref(false);
+
+const contact = computed(
+  () =>
+    store.getters['contacts/getContact'](props.chat?.meta?.sender?.id) || {}
+);
+const cpf = computed(
+  () => contact.value?.custom_attributes?.cpf || contact.value?.identifier || ''
+);
+const nome = computed(() => contact.value?.name || '');
+
+const abrirPainel = () => {
+  updateUISettings({
+    is_contact_sidebar_open: true,
+    is_copilot_panel_open: false,
+  });
+};
+
+// A acao e entregue ao painel FP (ConversationSidebar -> FpFrame -> iframe)
+const enviarAcao = acao => {
+  abrirPainel();
+  window.dispatchEvent(new CustomEvent('fp:acao', { detail: { acao } }));
+  isOpen.value = false;
+};
+
+const abrirExterno = url => {
+  window.open(url, '_blank', 'noopener');
+  isOpen.value = false;
+};
+
+const acoes = computed(() => [
+  { rot: 'Tabular rápido', ic: '📋', run: () => enviarAcao('tabular') },
+  { rot: 'Agendar retorno', ic: '📅', run: () => enviarAcao('agendar') },
+  {
+    rot: 'Ficha do cliente',
+    ic: '🧾',
+    run: () => {
+      abrirPainel();
+      isOpen.value = false;
+    },
+  },
+  {
+    rot: 'Simulador',
+    ic: '🧮',
+    run: () =>
+      abrirExterno(
+        `/clientes/embed/simulador-c6?cpf=${encodeURIComponent(cpf.value)}&nome=${encodeURIComponent(nome.value)}`
+      ),
+  },
+  { rot: 'Enviar template', ic: '📨', run: () => enviarAcao('template') },
+  {
+    rot: 'Abrir na base',
+    ic: '🗂',
+    run: () =>
+      abrirExterno(
+        `/clientes/busca?tipo=cpf&q=${encodeURIComponent(cpf.value)}`
+      ),
+  },
+]);
+</script>
+
+<template>
+  <div v-on-click-outside="() => (isOpen = false)" class="relative">
+    <button
+      type="button"
+      class="fp-btn"
+      :class="{ 'fp-btn--on': isOpen }"
+      @click="isOpen = !isOpen"
+    >
+      <span class="fp-dot" />
+      Ações FP
+      <span class="fp-caretsign">▾</span>
+    </button>
+    <div v-if="isOpen" class="fp-menu">
+      <button
+        v-for="acao in acoes"
+        :key="acao.rot"
+        type="button"
+        class="fp-item"
+        @click="acao.run()"
+      >
+        <span class="fp-ic">{{ acao.ic }}</span>
+        {{ acao.rot }}
+      </button>
+    </div>
+  </div>
+</template>
+
+<style scoped>
+.fp-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  height: 32px;
+  padding: 0 12px;
+  border: 0;
+  border-radius: 9px;
+  background: linear-gradient(135deg, #2b7fe0, #5b6cf0);
+  color: #fff;
+  font-size: 12.5px;
+  font-weight: 700;
+  cursor: pointer;
+  box-shadow: 0 6px 16px rgba(43, 127, 224, 0.35);
+}
+.fp-btn--on {
+  filter: brightness(1.08);
+}
+.fp-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: #fff;
+}
+.fp-caretsign {
+  font-size: 10px;
+  opacity: 0.85;
+}
+.fp-menu {
+  position: absolute;
+  top: 38px;
+  right: 0;
+  z-index: 60;
+  min-width: 210px;
+  padding: 6px;
+  background: #fff;
+  border: 1px solid #e2e9f5;
+  border-radius: 12px;
+  box-shadow: 0 18px 44px rgba(16, 24, 40, 0.18);
+}
+.fp-item {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  width: 100%;
+  padding: 8px 10px;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: #132036;
+  font-size: 13px;
+  font-weight: 600;
+  text-align: left;
+  cursor: pointer;
+}
+.fp-item:hover {
+  background: rgba(43, 127, 224, 0.12);
+}
+.fp-ic {
+  width: 18px;
+  text-align: center;
+}
+:global(.dark) .fp-menu {
+  background: #121829;
+  border-color: #232d47;
+}
+:global(.dark) .fp-item {
+  color: #e8eefc;
+}
+:global(.dark) .fp-item:hover {
+  background: rgba(124, 58, 237, 0.22);
+}
+</style>
diff --git a/app/javascript/dashboard/components/widgets/conversation/FpFrame.vue b/app/javascript/dashboard/components/widgets/conversation/FpFrame.vue
new file mode 100644
index 0000000..237188f
--- /dev/null
+++ b/app/javascript/dashboard/components/widgets/conversation/FpFrame.vue
@@ -0,0 +1,118 @@
+<script>
+const FETCH_INFO_MESSAGE = 'chatwoot-dashboard-app:fetch-info';
+const APP_CONTEXT_EVENT = 'appContext';
+const DARK_THEME = 'dark';
+const LIGHT_THEME = 'light';
+
+const getCurrentTheme = () =>
+  document.body.classList.contains(DARK_THEME) ? DARK_THEME : LIGHT_THEME;
+
+// Painel FP Consignado embutido no lugar do painel de contato do Chatwoot.
+// Fala o MESMO protocolo dos Dashboard Apps (Frame.vue): o iframe pede o
+// contexto e a gente responde. Alem disso escuta o evento 'fp:acao' (vindo
+// dos botoes do cabecalho) e repassa para o painel.
+export default {
+  props: {
+    currentChat: {
+      type: Object,
+      default: () => ({}),
+    },
+  },
+  data() {
+    return {
+      currentTheme: getCurrentTheme(),
+      themeObserver: null,
+    };
+  },
+  computed: {
+    contactId() {
+      return this.currentChat?.meta?.sender?.id;
+    },
+    contact() {
+      return this.$store.getters['contacts/getContact'](this.contactId) || {};
+    },
+    iframeUrl() {
+      const cpf =
+        this.contact?.custom_attributes?.cpf || this.contact?.identifier || '';
+      const nome = this.contact?.name || '';
+      const params = new URLSearchParams();
+      if (cpf) params.set('cpf', cpf);
+      if (nome) params.set('nome', nome);
+      if (this.currentChat?.id) {
+        params.set('conversa', String(this.currentChat.id));
+      }
+      const query = params.toString();
+      return `/clientes/embed${query ? `?${query}` : ''}`;
+    },
+    currentAgent() {
+      const { id, name, email } = this.$store.getters.getCurrentUser;
+      return { id, name, email };
+    },
+    appContext() {
+      return {
+        conversation: this.currentChat,
+        contact: this.contact,
+        currentAgent: this.currentAgent,
+        customAttributes: this.$store.getters['attributes/getAttributes'],
+        theme: this.currentTheme,
+      };
+    },
+  },
+  mounted() {
+    window.addEventListener('message', this.onMessage);
+    window.addEventListener('fp:acao', this.onAcao);
+    this.themeObserver = new MutationObserver(this.onThemeChange);
+    this.themeObserver.observe(document.body, {
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+  },
+  unmounted() {
+    window.removeEventListener('message', this.onMessage);
+    window.removeEventListener('fp:acao', this.onAcao);
+    this.themeObserver.disconnect();
+  },
+  methods: {
+    onMessage(event) {
+      if (event.data !== FETCH_INFO_MESSAGE) return;
+      if (this.$refs.frame?.contentWindow !== event.source) return;
+      this.sendContext();
+    },
+    onAcao(event) {
+      const frame = this.$refs.frame;
+      if (!frame?.contentWindow) return;
+      frame.contentWindow.postMessage(
+        JSON.stringify({ event: 'fp:acao', data: event.detail || {} }),
+        '*'
+      );
+    },
+    onThemeChange() {
+      const theme = getCurrentTheme();
+      if (theme === this.currentTheme) return;
+      this.currentTheme = theme;
+      this.sendContext();
+    },
+    sendContext() {
+      const frame = this.$refs.frame;
+      if (!frame?.contentWindow) return;
+      frame.contentWindow.postMessage(
+        JSON.stringify({ event: APP_CONTEXT_EVENT, data: this.appContext }),
+        '*'
+      );
+    },
+  },
+};
+</script>
+
+<template>
+  <iframe ref="frame" :src="iframeUrl" class="fp-frame" @load="sendContext" />
+</template>
+
+<style scoped>
+.fp-frame {
+  width: 100%;
+  height: 100%;
+  border: 0;
+  display: block;
+}
+</style>
