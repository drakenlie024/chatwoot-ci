+<script>
+// Painelzinho de "novo atendimento": abre a NOSSA telinha num iframe por cima
+// do Chatwoot. Ela fala com o painel e devolve o evento 'fp:novo-atendimento'
+// com a URL da conversa criada - ai a gente navega para ela.
+const MENSAGEM_FECHAR = 'fp:fechar-novo-atendimento';
+const MENSAGEM_CRIADO = 'fp:novo-atendimento';
+
+export default {
+  name: 'FpNovoAtendimento',
+  emits: ['close'],
+  computed: {
+    tema() {
+      return document.body.classList.contains('dark') ? 'dark' : 'light';
+    },
+    iframeUrl() {
+      return '/clientes/embed/novo-atendimento?tema=' + this.tema;
+    },
+  },
+  mounted() {
+    window.addEventListener('message', this.onMessage);
+    window.addEventListener('keydown', this.onKey);
+  },
+  unmounted() {
+    window.removeEventListener('message', this.onMessage);
+    window.removeEventListener('keydown', this.onKey);
+  },
+  methods: {
+    onKey(e) {
+      if (e.key === 'Escape') this.$emit('close');
+    },
+    onMessage(event) {
+      const frame = this.$refs.frame;
+      if (!frame || frame.contentWindow !== event.source) return;
+      let dados = event.data;
+      if (typeof dados === 'string') {
+        try { dados = JSON.parse(dados); } catch (e) { return; }
+      }
+      if (!dados || !dados.event) return;
+      if (dados.event === MENSAGEM_FECHAR) {
+        this.$emit('close');
+        return;
+      }
+      if (dados.event === MENSAGEM_CRIADO) {
+        this.$emit('close');
+        const url = dados.data && dados.data.url;
+        if (url) window.location.href = url;
+      }
+    },
+  },
+};
+</script>
+
+<template>
+  <div class="fp-novo-fundo" @click.self="$emit('close')">
+    <div class="fp-novo-caixa">
+      <button class="fp-novo-x" @click="$emit('close')" aria-label="Fechar">x</button>
+      <iframe ref="frame" :src="iframeUrl" class="fp-novo-frame" />
+    </div>
+  </div>
+</template>
+
+<style scoped>
+.fp-novo-fundo{position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:10000;
+  display:flex;align-items:flex-start;justify-content:center;padding:48px 16px}
+.fp-novo-caixa{position:relative;background:#fff;border-radius:16px;overflow:hidden;
+  width:560px;max-width:100%;max-height:calc(100vh - 96px);display:flex;
+  box-shadow:0 24px 60px rgba(0,0,0,.35)}
+.fp-novo-x{position:absolute;top:10px;right:12px;z-index:2;border:0;background:transparent;
+  font-size:22px;line-height:1;cursor:pointer;color:#64748b}
+.fp-novo-frame{width:560px;height:620px;max-width:100%;border:0;display:block}
+</style>
