diff --git a/app/javascript/dashboard/components/widgets/conversation/FpFrame.vue b/app/javascript/dashboard/components/widgets/conversation/FpFrame.vue
new file mode 100644
index 0000000..237188f
--- /dev/null
+++ b/app/javascript/dashboard/components/widgets/conversation/FpFrame.vue
@@ -0,0 +1,118 @@
+<script>
+const FETCH_INFO_MESSAGE = 'chatwoot-dashboard-app:fetch-info';
+const APP_CONTEXT_EVENT = 'appContext';
+const DARK_THEME = 'dark';
+const LIGHT_THEME = 'light';
+
+const getCurrentTheme = () =>
+  document.body.classList.contains(DARK_THEME) ? DARK_THEME : LIGHT_THEME;
+
+// Painel FP Consignado embutido no lugar do painel de contato do Chatwoot.
+// Fala o MESMO protocolo dos Dashboard Apps (Frame.vue): o iframe pede o
+// contexto e a gente responde. Alem disso escuta o evento 'fp:acao' (vindo
+// dos botoes do cabecalho) e repassa para o painel.
+export default {
+  props: {
+    currentChat: {
+      type: Object,
+      default: () => ({}),
+    },
+  },
+  data() {
+    return {
+      currentTheme: getCurrentTheme(),
+      themeObserver: null,
+    };
+  },
+  computed: {
+    contactId() {
+      return this.currentChat?.meta?.sender?.id;
+    },
+    contact() {
+      return this.$store.getters['contacts/getContact'](this.contactId) || {};
+    },
+    iframeUrl() {
+      const cpf =
+        this.contact?.custom_attributes?.cpf || this.contact?.identifier || '';
+      const nome = this.contact?.name || '';
+      const params = new URLSearchParams();
+      if (cpf) params.set('cpf', cpf);
+      if (nome) params.set('nome', nome);
+      if (this.currentChat?.id) {
+        params.set('conversa', String(this.currentChat.id));
+      }
+      const query = params.toString();
+      return `/clientes/embed${query ? `?${query}` : ''}`;
+    },
+    currentAgent() {
+      const { id, name, email } = this.$store.getters.getCurrentUser;
+      return { id, name, email };
+    },
+    appContext() {
+      return {
+        conversation: this.currentChat,
+        contact: this.contact,
+        currentAgent: this.currentAgent,
+        customAttributes: this.$store.getters['attributes/getAttributes'],
+        theme: this.currentTheme,
+      };
+    },
+  },
+  mounted() {
+    window.addEventListener('message', this.onMessage);
+    window.addEventListener('fp:acao', this.onAcao);
+    this.themeObserver = new MutationObserver(this.onThemeChange);
+    this.themeObserver.observe(document.body, {
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+  },
+  unmounted() {
+    window.removeEventListener('message', this.onMessage);
+    window.removeEventListener('fp:acao', this.onAcao);
+    this.themeObserver.disconnect();
+  },
+  methods: {
+    onMessage(event) {
+      if (event.data !== FETCH_INFO_MESSAGE) return;
+      if (this.$refs.frame?.contentWindow !== event.source) return;
+      this.sendContext();
+    },
+    onAcao(event) {
+      const frame = this.$refs.frame;
+      if (!frame?.contentWindow) return;
+      frame.contentWindow.postMessage(
+        JSON.stringify({ event: 'fp:acao', data: event.detail || {} }),
+        '*'
+      );
+    },
+    onThemeChange() {
+      const theme = getCurrentTheme();
+      if (theme === this.currentTheme) return;
+      this.currentTheme = theme;
+      this.sendContext();
+    },
+    sendContext() {
+      const frame = this.$refs.frame;
+      if (!frame?.contentWindow) return;
+      frame.contentWindow.postMessage(
+        JSON.stringify({ event: APP_CONTEXT_EVENT, data: this.appContext }),
+        '*'
+      );
+    },
+  },
+};
+</script>
+
+<template>
+  <iframe ref="frame" :src="iframeUrl" class="fp-frame" @load="sendContext" />
+</template>
+
+<style scoped>
+.fp-frame {
+  width: 100%;
+  height: 100%;
+  border: 0;
+  display: block;
+}
+</style>
diff --git a/app/javascript/dashboard/components/widgets/conversation/FpTabular.vue b/app/javascript/dashboard/components/widgets/conversation/FpTabular.vue
new file mode 100644
index 0000000..6d75fce
--- /dev/null
+++ b/app/javascript/dashboard/components/widgets/conversation/FpTabular.vue
@@ -0,0 +1,75 @@
+<script>
+const MENSAGEM_FECHAR = 'fp:fechar-tabular';
+const MENSAGEM_OK = 'fp:tabular-ok';
+
+export default {
+  name: 'FpTabular',
+  props: { chat: { type: Object, default: () => ({}) } },
+  emits: ['close', 'tabulated'],
+  computed: {
+    tema() {
+      return document.body.classList.contains('dark') ? 'dark' : 'light';
+    },
+    contato() {
+      const id =
+        this.chat && this.chat.meta && this.chat.meta.sender
+          ? this.chat.meta.sender.id
+          : null;
+      return id ? this.$store.getters['contacts/getContact'](id) || {} : {};
+    },
+    iframeUrl() {
+      const p = new URLSearchParams();
+      if (this.contato && this.contato.id) p.set('contact_id', String(this.contato.id));
+      if (this.contato && this.contato.name) p.set('nome', this.contato.name);
+      p.set('tema', this.tema);
+      return '/clientes/embed/tabular?' + p.toString();
+    },
+  },
+  mounted() {
+    window.addEventListener('message', this.onMessage);
+    window.addEventListener('keydown', this.onKey);
+  },
+  unmounted() {
+    window.removeEventListener('message', this.onMessage);
+    window.removeEventListener('keydown', this.onKey);
+  },
+  methods: {
+    onKey(e) {
+      if (e.key === 'Escape') this.$emit('close');
+    },
+    onMessage(event) {
+      const frame = this.$refs.frame;
+      if (!frame || frame.contentWindow !== event.source) return;
+      let d = event.data;
+      if (typeof d === 'string') {
+        try { d = JSON.parse(d); } catch (e) { return; }
+      }
+      if (!d || !d.event) return;
+      if (d.event === MENSAGEM_FECHAR) this.$emit('close');
+      else if (d.event === MENSAGEM_OK) this.$emit('tabulated', d.data || {});
+    },
+  },
+};
+</script>
+
+<template>
+  <Teleport to="body">
+    <div class="fp-tab-fundo" @click.self="$emit('close')">
+      <div class="fp-tab-caixa">
+        <button class="fp-tab-x" @click="$emit('close')" aria-label="Fechar">x</button>
+        <iframe ref="frame" :src="iframeUrl" class="fp-tab-frame" />
+      </div>
+    </div>
+  </Teleport>
+</template>
+
+<style scoped>
+.fp-tab-fundo{position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:10000;
+  display:flex;align-items:flex-start;justify-content:center;padding:44px 16px}
+.fp-tab-caixa{position:relative;background:#fff;border-radius:16px;overflow:hidden;
+  width:520px;max-width:100%;max-height:calc(100vh - 88px);display:flex;
+  box-shadow:0 24px 60px rgba(0,0,0,.35)}
+.fp-tab-x{position:absolute;top:8px;right:10px;z-index:2;border:0;background:transparent;
+  font-size:20px;line-height:1;cursor:pointer;color:rgba(255,255,255,.9)}
+.fp-tab-frame{width:520px;height:560px;max-width:100%;border:0;display:block}
+</style>
