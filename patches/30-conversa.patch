diff --git a/app/javascript/dashboard/components/widgets/conversation/FpActions.vue b/app/javascript/dashboard/components/widgets/conversation/FpActions.vue
new file mode 100644
index 0000000..6d5526e
--- /dev/null
+++ b/app/javascript/dashboard/components/widgets/conversation/FpActions.vue
@@ -0,0 +1,183 @@
+<script setup>
+import { computed, ref } from 'vue';
+import FpTabular from './FpTabular.vue';
+import FpTemplate from './FpTemplate.vue';
+import { useStore } from 'vuex';
+import { useUISettings } from 'dashboard/composables/useUISettings';
+
+const props = defineProps({
+  chat: {
+    type: Object,
+    default: () => ({}),
+  },
+});
+
+const store = useStore();
+const tabularAberto = ref(false);
+const templateAberto = ref(false);
+const { updateUISettings } = useUISettings();
+
+const contact = computed(
+  () =>
+    store.getters['contacts/getContact'](props.chat?.meta?.sender?.id) || {}
+);
+const nome = computed(() => contact.value?.name || '');
+const cpfBruto = computed(
+  () =>
+    contact.value?.custom_attributes?.cpf ||
+    contact.value?.identifier ||
+    ''
+);
+const cpfLimpo = computed(() => String(cpfBruto.value).replace(/\D/g, ''));
+const cpfOk = computed(() => cpfLimpo.value.length === 11);
+const telefone = computed(() => contact.value?.phone_number || '');
+// "Abrir na base": busca por CPF quando existe; senao, pelo telefone.
+const buscaTipo = computed(() =>
+  cpfOk.value ? 'cpf' : telefone.value ? 'telefone' : 'cpf'
+);
+const buscaQ = computed(() =>
+  cpfOk.value ? cpfLimpo.value : telefone.value || cpfBruto.value
+);
+
+const abrirPainel = () => {
+  updateUISettings({
+    is_contact_sidebar_open: true,
+    is_copilot_panel_open: false,
+  });
+};
+
+// A acao vai para o painel FP (ConversationSidebar -> FpFrame -> iframe). Como o
+// iframe pode estar montando ainda, repetimos por alguns segundos ate chegar.
+const enviarAcao = acao => {
+  abrirPainel();
+  if (window.__fpAcaoTimer) clearInterval(window.__fpAcaoTimer);
+  let n = 0;
+  window.__fpAcaoTimer = setInterval(() => {
+    window.dispatchEvent(new CustomEvent('fp:acao', { detail: { acao } }));
+    if (++n >= 10) {
+      clearInterval(window.__fpAcaoTimer);
+      window.__fpAcaoTimer = null;
+    }
+  }, 400);
+};
+
+const abrirExterno = url => {
+  window.open(url, '_blank', 'noopener');
+};
+
+const acoes = computed(() => [
+  {
+    rot: 'Tabular rápido',
+    curto: 'Tabular',
+    ic: 'i-lucide-clipboard-check',
+    run: () => (tabularAberto.value = true),
+  },
+  {
+    rot: 'Ficha do cliente',
+    curto: 'Ficha',
+    ic: 'i-lucide-file-text',
+    run: () => abrirPainel(),
+  },
+  {
+    rot: 'Simulador de empréstimo',
+    curto: 'Simulador',
+    ic: 'i-lucide-calculator',
+    run: () =>
+      abrirExterno(
+        `/clientes/embed/simulador?cpf=${encodeURIComponent(cpfOk.value ? cpfLimpo.value : '')}&nome=${encodeURIComponent(nome.value)}`
+      ),
+  },
+  {
+    rot: 'Enviar template',
+    curto: 'Template',
+    ic: 'i-lucide-send',
+    run: () => (templateAberto.value = true),
+  },
+]);
+</script>
+
+<template>
+  <div class="fp-group">
+    <button
+      v-for="a in acoes"
+      :key="a.rot"
+      type="button"
+      class="fp-b"
+      :title="a.rot"
+      @click="a.run()"
+    >
+      <span class="fp-b-ic" :class="a.ic" />
+      <span class="fp-b-tx">{{ a.curto }}</span>
+    </button>
+  </div>
+  <FpTabular
+    v-if="tabularAberto"
+    :chat="props.chat"
+    @close="tabularAberto = false"
+  />
+  <FpTemplate
+    v-if="templateAberto"
+    :chat="props.chat"
+    @close="templateAberto = false"
+  />
+</template>
+
+<style scoped>
+.fp-group {
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+  padding: 2px;
+  border: 1px solid #e2e9f5;
+  border-radius: 11px;
+  background: #fff;
+  flex-shrink: 0;
+}
+.fp-b {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  height: 28px;
+  padding: 0 9px;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: #334155;
+  font-size: 12px;
+  font-weight: 700;
+  white-space: nowrap;
+  cursor: pointer;
+}
+.fp-b:hover {
+  background: linear-gradient(
+    135deg,
+    rgba(43, 127, 224, 0.16),
+    rgba(124, 58, 237, 0.14)
+  );
+  color: #1d4ed8;
+}
+.fp-b-ic {
+  width: 15px;
+  height: 15px;
+  flex: none;
+  display: inline-block;
+}
+.fp-b-tx {
+  line-height: 1;
+}
+@media (max-width: 1279px) {
+  .fp-b-tx {
+    display: none;
+  }
+}
+:global(.dark) .fp-group {
+  background: #121829;
+  border-color: #232d47;
+}
+:global(.dark) .fp-b {
+  color: #c7d2e6;
+}
+:global(.dark) .fp-b:hover {
+  color: #a5c4ff;
+}
+</style>
diff --git a/app/javascript/dashboard/components/widgets/conversation/FpChatWidget.vue b/app/javascript/dashboard/components/widgets/conversation/FpChatWidget.vue
new file mode 100644
index 0000000..c8f319c
--- /dev/null
+++ b/app/javascript/dashboard/components/widgets/conversation/FpChatWidget.vue
@@ -0,0 +1,390 @@
+<script>
+const FETCH_INFO_MESSAGE = 'chatwoot-dashboard-app:fetch-info';
+const APP_CONTEXT_EVENT = 'appContext';
+const DARK_THEME = 'dark';
+
+// A posicao da bolha (quando o operador arrasta) fica salva por navegador.
+const POS_KEY = 'fp-chat-pos';
+const BOLHA = 52; // lado da bolha, em px
+const MARGEM = 12; // respiro minimo das bordas
+const PAINEL_L = 372;
+const PAINEL_A = 540;
+
+const getCurrentTheme = () =>
+  document.body.classList.contains(DARK_THEME) ? DARK_THEME : 'light';
+
+// Chat interno da FP como WIDGET flutuante: aparece em todas as telas do
+// dashboard, nasce no canto inferior direito e pode ser ARRASTADO para onde o
+// operador quiser (a posicao fica salva). O painel abre acima ou abaixo da
+// bolha, conforme o espaco, e nunca sai da tela.
+//
+// ATENCAO (armadilha paga): tudo que o TEMPLATE chama tem que ser `method`.
+// O compilador resolve chamada do template como `$options.<nome>`, e o
+// `$options` traz os metodos, mas NAO os computeds - chamar computed no
+// template da "TypeError: x is not a function" e o componente nao renderiza
+// (o dashboard segue, o widget some). Por isso posicao/estilo sao methods.
+export default {
+  data() {
+    return {
+      aberto: false,
+      carregado: false,
+      naoLidas: 0,
+      currentTheme: getCurrentTheme(),
+      themeObserver: null,
+      pos: null, // {x, y} em px; null = canto inferior direito
+      arrasto: null, // {dx, dy, moveu} enquanto o ponteiro esta pressionado
+      janela: { w: window.innerWidth, h: window.innerHeight },
+    };
+  },
+  computed: {
+    // Só uso interno (nunca chamado do template).
+    currentAgent() {
+      const { id, name, email } = this.$store.getters.getCurrentUser;
+      return { id, name, email };
+    },
+    appContext() {
+      return {
+        currentAgent: this.currentAgent,
+        conversation: this.$store.getters.getSelectedChat || {},
+        contact: {},
+        theme: this.currentTheme,
+      };
+    },
+  },
+  mounted() {
+    window.addEventListener('message', this.onMessage);
+    window.addEventListener('resize', this.onResize);
+    this.themeObserver = new MutationObserver(this.onThemeChange);
+    this.themeObserver.observe(document.body, {
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+    this.pos = this.lerPosicao();
+  },
+  unmounted() {
+    window.removeEventListener('message', this.onMessage);
+    window.removeEventListener('resize', this.onResize);
+    this.soltaPonteiro();
+    this.themeObserver.disconnect();
+  },
+  methods: {
+    // -------------------------------------------------- posicao e estilo
+    // (methods, e nao computeds: ver o aviso no topo do arquivo)
+    posicaoBolha() {
+      if (this.pos) return this.pos;
+      return {
+        x: this.janela.w - MARGEM - BOLHA,
+        y: this.janela.h - MARGEM - BOLHA,
+      };
+    },
+    estiloBolha() {
+      if (!this.pos) return {}; // sem arrasto, o CSS cuida (right/bottom)
+      return {
+        left: `${this.pos.x}px`,
+        top: `${this.pos.y}px`,
+        right: 'auto',
+        bottom: 'auto',
+      };
+    },
+    larguraPainel() {
+      return Math.min(PAINEL_L, this.janela.w - 2 * MARGEM);
+    },
+    alturaPainel() {
+      return Math.min(PAINEL_A, this.janela.h - BOLHA - 3 * MARGEM);
+    },
+    // Abre acima da bolha quando ha espaco; senao, abaixo. Alinha na horizontal
+    // para o painel inteiro caber na janela.
+    estiloPainel() {
+      const b = this.posicaoBolha();
+      const largura = this.larguraPainel();
+      const altura = this.alturaPainel();
+      const desloca =
+        Math.max(MARGEM, Math.min(b.x, this.janela.w - MARGEM - largura)) - b.x;
+      const estilo = {
+        width: `${largura}px`,
+        height: `${altura}px`,
+        left: `${desloca}px`,
+      };
+      if (b.y > altura + BOLHA + 2 * MARGEM) estilo.bottom = `${BOLHA + MARGEM}px`;
+      else estilo.top = `${BOLHA + MARGEM}px`;
+      return estilo;
+    },
+    limitar(p) {
+      return {
+        x: Math.max(MARGEM, Math.min(p.x, this.janela.w - MARGEM - BOLHA)),
+        y: Math.max(MARGEM, Math.min(p.y, this.janela.h - MARGEM - BOLHA)),
+      };
+    },
+    lerPosicao() {
+      try {
+        const p = JSON.parse(localStorage.getItem(POS_KEY) || 'null');
+        if (p && typeof p.x === 'number' && typeof p.y === 'number') {
+          return this.limitar(p);
+        }
+      } catch (e) {
+        /* posicao salva invalida: volta para o canto */
+      }
+      return null;
+    },
+    onResize() {
+      this.janela = { w: window.innerWidth, h: window.innerHeight };
+      if (this.pos) this.pos = this.limitar(this.pos);
+    },
+    // ------------------------------------------------------------ arrasto
+    arrastarInicio(e) {
+      if (e.button !== undefined && e.button !== 0) return;
+      const b = this.posicaoBolha();
+      this.arrasto = { dx: e.clientX - b.x, dy: e.clientY - b.y, moveu: false };
+      window.addEventListener('pointermove', this.arrastarMover);
+      window.addEventListener('pointerup', this.arrastarFim);
+      window.addEventListener('pointercancel', this.arrastarFim);
+    },
+    arrastarMover(e) {
+      if (!this.arrasto) return;
+      const p = this.limitar({
+        x: e.clientX - this.arrasto.dx,
+        y: e.clientY - this.arrasto.dy,
+      });
+      const atual = this.posicaoBolha();
+      if (Math.abs(p.x - atual.x) + Math.abs(p.y - atual.y) > 4) {
+        this.arrasto.moveu = true;
+      }
+      this.pos = p;
+      e.preventDefault();
+    },
+    arrastarFim() {
+      const moveu = !!(this.arrasto && this.arrasto.moveu);
+      this.soltaPonteiro();
+      this.arrasto = null;
+      if (moveu) {
+        try {
+          localStorage.setItem(POS_KEY, JSON.stringify(this.pos));
+        } catch (e) {
+          /* sem localStorage: so nao guarda a posicao */
+        }
+      } else {
+        this.alternar(); // foi clique, nao arrasto
+      }
+    },
+    soltaPonteiro() {
+      window.removeEventListener('pointermove', this.arrastarMover);
+      window.removeEventListener('pointerup', this.arrastarFim);
+      window.removeEventListener('pointercancel', this.arrastarFim);
+    },
+    // --------------------------------------------------------------- chat
+    alternar() {
+      this.aberto = !this.aberto;
+      if (this.aberto) {
+        this.carregado = true;
+        this.naoLidas = 0;
+      }
+    },
+    // Clique de teclado (Enter/Espaco) tem detail 0; o de mouse passou pelo arrasto.
+    aoClicar(e) {
+      if (e.detail === 0) this.alternar();
+    },
+    onMessage(event) {
+      let dados = event.data;
+      if (typeof dados === 'string') {
+        try {
+          dados = JSON.parse(dados);
+        } catch (e) {
+          return;
+        }
+      }
+      if (!dados) return;
+      if (dados.event === 'fp:chat-nao-lidas') {
+        if (!this.aberto) this.naoLidas = Number(dados.data?.n || 0);
+        return;
+      }
+      if (dados !== FETCH_INFO_MESSAGE) return;
+      if (this.$refs.frame?.contentWindow === event.source) this.sendContext();
+    },
+    onThemeChange() {
+      const theme = getCurrentTheme();
+      if (theme === this.currentTheme) return;
+      this.currentTheme = theme;
+      this.sendContext();
+    },
+    sendContext() {
+      const frame = this.$refs.frame;
+      if (!frame?.contentWindow) return;
+      frame.contentWindow.postMessage(
+        JSON.stringify({ event: APP_CONTEXT_EVENT, data: this.appContext }),
+        '*'
+      );
+    },
+  },
+};
+</script>
+
+<template>
+  <div class="fp-chat" :style="estiloBolha()">
+    <transition name="fp-chat-fade">
+      <section v-if="aberto" class="fp-chat-panel" :style="estiloPainel()">
+        <header class="fp-chat-top">
+          <span class="fp-chat-title">Chat Interno</span>
+          <button
+            type="button"
+            class="fp-chat-close"
+            title="Fechar"
+            @click="alternar"
+          >
+            <span class="i-lucide-x" />
+          </button>
+        </header>
+        <iframe
+          v-if="carregado"
+          ref="frame"
+          src="/clientes/embed/chat"
+          class="fp-chat-frame"
+          @load="sendContext"
+        />
+      </section>
+    </transition>
+    <button
+      type="button"
+      class="fp-chat-bubble"
+      :class="{ 'fp-chat-bubble--on': aberto }"
+      :title="aberto ? 'Fechar chat interno' : 'Chat Interno — arraste para mover'"
+      @pointerdown="arrastarInicio"
+      @click="aoClicar"
+      @keydown.enter.prevent="alternar"
+      @keydown.space.prevent="alternar"
+    >
+      <span
+        class="fp-chat-ic"
+        :class="aberto ? 'i-lucide-chevron-down' : 'i-lucide-message-square'"
+      />
+      <span v-if="naoLidas > 0 && !aberto" class="fp-chat-badge">
+        {{ naoLidas > 9 ? '9+' : naoLidas }}
+      </span>
+    </button>
+  </div>
+</template>
+
+<style scoped>
+.fp-chat {
+  position: fixed;
+  right: 12px;
+  bottom: 12px;
+  z-index: 30;
+}
+.fp-chat-bubble {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
