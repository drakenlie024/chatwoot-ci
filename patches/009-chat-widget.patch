+<script>
+const FETCH_INFO_MESSAGE = 'chatwoot-dashboard-app:fetch-info';
+const APP_CONTEXT_EVENT = 'appContext';
+const DARK_THEME = 'dark';
+
+const getCurrentTheme = () =>
+  document.body.classList.contains(DARK_THEME) ? DARK_THEME : 'light';
+
+// Chat interno da FP como WIDGET flutuante: aparece em todas as telas do
+// dashboard (canto inferior direito) e abre um mini chat (iframe /embed/chat).
+// Fala o mesmo protocolo dos Dashboard Apps com o nosso painel.
+export default {
+  data() {
+    return {
+      aberto: false,
+      carregado: false,
+      naoLidas: 0,
+      currentTheme: getCurrentTheme(),
+      themeObserver: null,
+    };
+  },
+  computed: {
+    currentAgent() {
+      const { id, name, email } = this.$store.getters.getCurrentUser;
+      return { id, name, email };
+    },
+    appContext() {
+      return {
+        currentAgent: this.currentAgent,
+        conversation: this.$store.getters.getSelectedChat || {},
+        contact: {},
+        theme: this.currentTheme,
+      };
+    },
+  },
+  mounted() {
+    window.addEventListener('message', this.onMessage);
+    this.themeObserver = new MutationObserver(this.onThemeChange);
+    this.themeObserver.observe(document.body, {
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+  },
+  unmounted() {
+    window.removeEventListener('message', this.onMessage);
+    this.themeObserver.disconnect();
+  },
+  methods: {
+    alternar() {
+      this.aberto = !this.aberto;
+      if (this.aberto) {
+        this.carregado = true;
+        this.naoLidas = 0;
+      }
+    },
+    onMessage(event) {
+      let dados = event.data;
+      if (typeof dados === 'string') {
+        try {
+          dados = JSON.parse(dados);
+        } catch (e) {
+          return;
+        }
+      }
+      if (!dados) return;
+      if (dados.event === 'fp:chat-nao-lidas') {
+        if (!this.aberto) this.naoLidas = Number(dados.data?.n || 0);
+        return;
+      }
+      if (dados !== FETCH_INFO_MESSAGE) return;
+      if (this.$refs.frame?.contentWindow === event.source) this.sendContext();
+    },
+    onThemeChange() {
+      const theme = getCurrentTheme();
+      if (theme === this.currentTheme) return;
+      this.currentTheme = theme;
+      this.sendContext();
+    },
+    sendContext() {
+      const frame = this.$refs.frame;
+      if (!frame?.contentWindow) return;
+      frame.contentWindow.postMessage(
+        JSON.stringify({ event: APP_CONTEXT_EVENT, data: this.appContext }),
+        '*'
+      );
+    },
+  },
+};
+</script>
+
+<template>
+  <div class="fp-chat">
+    <transition name="fp-chat-fade">
+      <section v-if="aberto" class="fp-chat-panel">
+        <header class="fp-chat-top">
+          <span class="fp-chat-title">Chat Interno</span>
+          <button
+            type="button"
+            class="fp-chat-close"
+            title="Fechar"
+            @click="alternar"
+          >
+            <span class="i-lucide-x" />
+          </button>
+        </header>
+        <iframe
+          v-if="carregado"
+          ref="frame"
+          src="/clientes/embed/chat"
+          class="fp-chat-frame"
+          @load="sendContext"
+        />
+      </section>
+    </transition>
+    <button
+      type="button"
+      class="fp-chat-bubble"
+      :class="{ 'fp-chat-bubble--on': aberto }"
+      :title="aberto ? 'Fechar chat interno' : 'Chat Interno'"
+      @click="alternar"
+    >
+      <span
+        class="fp-chat-ic"
+        :class="aberto ? 'i-lucide-chevron-down' : 'i-lucide-message-square'"
+      />
+      <span v-if="naoLidas > 0 && !aberto" class="fp-chat-badge">
+        {{ naoLidas > 9 ? '9+' : naoLidas }}
+      </span>
+    </button>
+  </div>
+</template>
+
+<style scoped>
+.fp-chat {
+  position: fixed;
+  right: 18px;
+  bottom: 18px;
+  z-index: 30;
+}
+.fp-chat-bubble {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 52px;
+  height: 52px;
+  border: 0;
+  border-radius: 50%;
+  background: linear-gradient(135deg, #2b7fe0, #5b6cf0);
+  color: #fff;
+  cursor: pointer;
+  box-shadow: 0 10px 26px rgba(43, 127, 224, 0.45);
+  transition: transform 0.15s ease;
+}
+.fp-chat-bubble:hover {
+  transform: translateY(-2px);
+}
+.fp-chat-bubble--on {
+  background: #334155;
+  box-shadow: 0 8px 20px rgba(15, 23, 42, 0.35);
+}
+.fp-chat-ic {
+  width: 22px;
+  height: 22px;
+  display: inline-block;
+}
+.fp-chat-badge {
+  position: absolute;
+  top: -3px;
+  right: -3px;
+  min-width: 19px;
+  height: 19px;
+  padding: 0 5px;
+  border-radius: 99px;
+  background: #ef4444;
+  color: #fff;
+  font-size: 11px;
+  font-weight: 800;
+  line-height: 19px;
+  text-align: center;
+  box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.9);
+}
+.fp-chat-panel {
+  position: absolute;
+  right: 0;
+  bottom: 64px;
+  width: 372px;
+  max-width: calc(100vw - 36px);
+  height: 540px;
+  max-height: calc(100vh - 96px);
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  background: #fff;
+  border: 1px solid #e2e9f5;
+  border-radius: 16px;
+  box-shadow: 0 24px 60px rgba(16, 24, 40, 0.28);
+}
+.fp-chat-top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 11px 14px;
+  background: linear-gradient(135deg, #2b7fe0, #5b6cf0);
+  color: #fff;
+}
+.fp-chat-title {
+  font-size: 13.5px;
+  font-weight: 800;
+  letter-spacing: 0.01em;
+}
+.fp-chat-close {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  border: 0;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.16);
+  color: #fff;
+  cursor: pointer;
+}
+.fp-chat-close:hover {
+  background: rgba(255, 255, 255, 0.28);
+}
+.fp-chat-frame {
+  flex: 1;
+  width: 100%;
+  border: 0;
+  display: block;
+  background: #fff;
+}
+.fp-chat-fade-enter-active,
+.fp-chat-fade-leave-active {
+  transition: opacity 0.15s ease, transform 0.15s ease;
+}
+.fp-chat-fade-enter-from,
+.fp-chat-fade-leave-to {
+  opacity: 0;
+  transform: translateY(8px);
+}
+:global(.dark) .fp-chat-panel {
+  background: #121829;
+  border-color: #232d47;
+}
+:global(.dark) .fp-chat-frame {
+  background: #0f1319;
+}
+</style>
