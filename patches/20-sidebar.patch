+// computed, que disparava o fetch de novo (o painel chegou a receber centenas
+// de GET /api/fila por segundo). Aqui: um fetch ao abrir + refresh de 60s.
+const meuDiaCount = ref(0);
+
+const buscarMeuDia = async () => {
+  const email = store.getters.getCurrentUser?.email;
+  if (!email) return;
+  try {
+    const resp = await fetch(
+      `/clientes/api/fila?operador=${encodeURIComponent(email)}`,
+      { credentials: 'include' }
+    );
+    if (!resp.ok) return;
+    const dados = await resp.json();
+    // /api/fila devolve um OBJETO com as listas da fila, nao uma lista.
+    // O numero do "Meu dia" e o total de clientes em todas elas.
+    if (Array.isArray(dados)) {
+      meuDiaCount.value = dados.length;
+    } else {
+      const listas = [
+        'agendados',
+        'atrasados',
+        'negociacao',
+        'reciclagem',
+        'desbloqueio',
+      ];
+      const soma = listas.reduce(
+        (t, k) => t + (Array.isArray(dados?.[k]) ? dados[k].length : 0),
+        0
+      );
+      meuDiaCount.value = soma || dados?.contadores?.total || 0;
+    }
+  } catch (e) {
+    // contador e cosmetico: se falhar o menu continua funcionando
+  }
+};
+
+let timerMeuDia = null;
+onMounted(() => {
+  buscarMeuDia();
